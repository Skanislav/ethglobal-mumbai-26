# Copy to .env and fill in. `.env*` is gitignored; this file is the template.
#
# Pinata JWT used by `bun run pin` / `bun run deploy`. Create it at
# https://app.pinata.cloud → API Keys → New Key with "Files: Write".
# This is a write credential: never commit it, never inline it in a command line.
PINATA_JWT=

# Optional: your dedicated Pinata gateway host (e.g. my-gw.mypinata.cloud). When set,
# the post-pin root check and the printed preview URL use it instead of dweb.link.
PINATA_GATEWAY=
